# Contoh konfigurasi Muse Command Center.
# Salin menjadi `.env` di direktori yang sama dengan server.py,
# lalu isi nilainya. JANGAN commit file `.env` ke git.
#
#   cp .env.example .env
#   chmod 600 .env

# IP yang di-bind server. Untuk akses via Tailscale, isi IP Tailscale VPS.
# Untuk uji lokal saja, biarkan 127.0.0.1.
MCC_BIND=127.0.0.1

# Port HTTP server.
MCC_PORT=9120

# Username akun utama dashboard.
MCC_USER=admin

# Password akun utama. WAJIB diganti — buat yang kuat & acak.
MCC_PASSWORD=ganti-dengan-password-yang-kuat

# Nama pengirim yang boleh memakai flag auto_execute (koma-dipisah,
# dibandingkan case-insensitive). Ini harus nama ANDA / akun-akun Anda.
# Contoh: MCC_AUTO_EXECUTE_ALLOW=julian,jharrvis
MCC_AUTO_EXECUTE_ALLOW=admin
